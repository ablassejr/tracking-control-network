rces#{1}":[1009,1009],"##10. Sources#Web Resources#{2}":[1010,1010],"##10. Sources#Web Resources#{3}":[1011,1011],"##10. Sources#Web Resources#{4}":[1012,1013]},"outlinks":[{"title":"0.1","target":"0.1","line":41},{"title":"Adversarial Attacks and Defenses in Automated Control Systems: A Comprehensive Benchmark","target":"https://arxiv.org/html/2403.13502v2","line":952},{"title":"RL-based Tracking Control for Nonlinear Systems with Adversarial Attacks","target":"https://arxiv.org/abs/2209.02165","line":954},{"title":"Event-Triggered Secure Control Against FDI Attacks via Lyapunov-Based Neural Networks","target":"https://pmc.ncbi.nlm.nih.gov/articles/PMC12197249/","line":956},{"title":"Learning Neural Network Safe Tracking Controllers from Backward Reachable Sets","target":"https://arxiv.org/html/2511.21953","line":958},{"title":"Certified Neural Network Control Architectures","target":"https://www.mdpi.com/2227-7390/13/10/1677","line":960},{"title":"Robust Deep Reinforcement Learning Through Adversarial Attacks and Training: A Survey","target":"https://ar5iv.labs.arxiv.org/html/2403.00420v1","line":962},{"title":"Data-driven Replay Attack Detection for Unknown CPS","target":"https://www.sciencedirect.com/science/article/abs/pii/S0020025524004754","line":964},{"title":"Machine Learning-Based Detection of Cyberattacks in ACC Systems","target":"https://www.nature.com/articles/s41598-025-20096-5","line":966},{"title":"Security Control of CPS under Cyber Attacks: A Survey","target":"https://pmc.ncbi.nlm.nih.gov/articles/PMC11207848/","line":968},{"title":"Reinforcement Learning Solution for CPS Security Against Replay Attacks","target":"https://dl.acm.org/doi/abs/10.1109/TIFS.2023.3268532","line":970},{"title":"NNV: The Neural Network Verification Tool","target":"https://github.com/verivital/nnv","line":972},{"title":"Injection Attacks Toolbox in MATLAB/Simulink","target":"https://ieeexplore.ieee.org/document/8972171/","line":974},{"title":"Detecting Stealthy Cyberattacks on ACC Vehicles","target":"https://arxiv.org/html/2310.17091","line":976},{"title":"Resilient Interval Observer-Based Control for Cooperative ACC under FDI Attack","target":"https://arxiv.org/html/2601.12625","line":978},{"title":"AI-Based IDS for In-Vehicle Networks: A Survey","target":"https://dl.acm.org/doi/10.1145/3570954","line":980},{"title":"Development of Injection Attacks Toolbox","target":"https://www.researchgate.net/publication/338948921","line":982},{"title":"IBM Adversarial Robustness Toolbox (ART)","target":"https://adversarial-robustness-toolbox.readthedocs.io/","line":986},{"title":"Foolbox: Adversarial Examples Toolbox","target":"https://github.com/bethgelab/foolbox","line":987},{"title":"CleverHans: Adversarial Example Library","target":"https://github.com/cleverhans-lab/cleverhans","line":988},{"title":"Python Control Systems Library - Stochastic Systems","target":"https://python-control.readthedocs.io/en/latest/stochastic.html","line":989},{"title":"Python Control - Discrete Nonlinear Simulation","target":"https://python-control.readthedocs.io/en/0.10.2/examples/simulating_discrete_nonlinear.html","line":990},{"title":"MATLAB idinput Function","target":"https://www.mathworks.com/help/ident/ref/idinput.html","line":991},{"title":"MATLAB PRBS Input Signals","target":"https://www.mathworks.com/help/slcontrol/ug/prbs-input-signals.html","line":992},{"title":"MATLAB Generate Adversarial Examples","target":"https://www.mathworks.com/help/deeplearning/ug/generate-adversarial-examples.html","line":993},{"title":"MATLAB Train Robust Network","target":"https://www.mathworks.com/help/deeplearning/ug/train-network-robust-to-adversarial-examples.html","line":994},{"title":"MATLAB verifyNetworkRobustness","target":"https://www.mathworks.com/help/deeplearning/ref/verifynetworkrobustness.html","line":995},{"title":"MATLAB Detect and Mitigate Attacks in Platooning","target":"https://www.mathworks.com/help/control/ug/detect-and-mitigate-attacks-in-vehicle-platooning.html","line":996},{"title":"MATLAB Sensor Spoofing Video","target":"https://www.mathworks.com/videos/sensor-spoofing-attacks-consequences-and-countermeasures-1550744665433.html","line":997},{"title":"RobustBench: Adversarial Robustness Benchmark","target":"https://robustbench.github.io/","line":998},{"title":"alpha-beta-CROWN Neural Network Verifier","target":"https://github.com/Verified-Intelligence/alpha-beta-CROWN","line":999},{"title":"Gymnasium Classic Control Environments","target":"https://gymnasium.farama.org/environments/classic_control/","line":1000},{"title":"TensorFlow FGSM Tutorial","target":"https://www.tensorflow.org/tutorials/generative/adversarial_fgsm","line":1001},{"title":"PyTorch FGSM Tutorial","target":"https://docs.pytorch.org/tutorials/beginner/fgsm_tutorial.html","line":1002},{"title":"MIT Underactuated Robotics - Stochastic Systems","target":"https://underactuated.mit.edu/stochastic.html","line":1003},{"title":"ONNX Runtime","target":"https://onnxruntime.ai/","line":1004},{"title":"ICS Injection Attack Toolbox","target":"https://github.com/sasankapotluri/ICS-Injection_Attack_Toolbox","line":1005},{"title":"Adversarial ML Tutorial","target":"https://adversarial-ml-tutorial.org/","line":1009},{"title":"MathWorks Adjust Disturbance and Noise Models","target":"https://www.mathworks.com/help/mpc/ug/adjusting-disturbance-and-noise-models.html","line":1010},{"title":"Engineering LibreTexts - Noise Modeling","target":"https://eng.libretexts.org/Bookshelves/Industrial_and_Systems_Engineering/Chemical_Process_Dynamics_and_Controls_\\(Woolf\\","line":1011},{"title":"ScienceDirect - Process Noise Overview","target":"https://www.sciencedirect.com/topics/engineering/process-noise","line":1012}],"metadata":{"tags":[],"parent":"","collections":[],"This report provides a comprehensive survey of noise models, adversarial attack techniques, simulation frameworks, benchmark problems, and recent research (2023--2026) relevant to defending neural network-based tracking controllers against adversarial attacks. The research covers discrete-time affine-in-the-inputs systems of the form $x(k+1) = f(x(k)) + g(x(k))u(k)$, where neural network controllers compute optimal control inputs and adversarial attacks target sensor measurements, actuator signals, or the neural network itself. Key findings include":"(1) a well-established taxonomy of noise and attack models ranging from Gaussian white noise to sophisticated false data injection and replay attacks; (2) mature simulation toolkits in MATLAB (Robust Control Toolbox, Deep Learning Toolbox, NNV) and Python (ART, Foolbox, python-control); (3) emerging research at the intersection of reinforcement learning, adversarial training, and control-theoretic stability guarantees; and (4) practical IDS/ACC benchmarks directly relevant to this project's analogy framework.","$version":0,"$libraryID":1,"$itemKey":"3ULDQWPF"},"task_lines":[],"tasks":{},"codeblock_ranges":[[27,33],[37,45],[59,66],[84,90],[100,109],[137,148],[152,161],[165,171],[183,193],[197,204],[228,236],[240,245],[255,258],[278,285],[303,311],[396,400],[428,435],[455,471],[483,489],[519,536],[550,566],[588,599],[609,626]],"last_embed":{"hash":"3ojhct","at":1771129847345}},"smart_blocks:Resources/adversarial-attacks-tracking-control-nn-2026-02-14.md#---frontmatter---": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06949147,-0.04146893,0.02159563,0.01856646,0.02844924,0.04560018,0.01861259,-0.00486341,0.03538284,0.00517751,0.00381012,-0.03237983,0.02363288,0.07805019,0.01496055,0.04023432,-0.04112824,-0.0064978,0.06318349,0.00661867,0.04409729,-0.00796449,0.04376283,-0.0288248,-0.0147336,0.02702746,-0.01207567,-0.04190514,-0.06377561,-0.25482178,-0.0032073,-0.04054249,0.03966517,0.01494028,-0.07390232,-0.03252225,-0.03951176,0.06484289,-0.0064339,0.02357485,0.02597445,0.06276608,0.01005665,-0.08960748,0.0195684,-0.0575338,-0.01313822,-0.07266111,-0.08134775,-0.03668527,-0.02326923,-0.07376435,0.04244171,-