0. Sources#Web Resources#{1}":[930,930],"##10. Sources#Web Resources#{2}":[931,931],"##10. Sources#Web Resources#{3}":[932,932],"##10. Sources#Web Resources#{4}":[933,934]},"outlinks":[{"title":"0.1","target":"0.1","line":41},{"title":"Adversarial Attacks and Defenses in Automated Control Systems: A Comprehensive Benchmark","target":"https://arxiv.org/html/2403.13502v2","line":888},{"title":"RL-based Tracking Control for Nonlinear Systems with Adversarial Attacks","target":"https://arxiv.org/abs/2209.02165","line":889},{"title":"Event-Triggered Secure Control Against FDI Attacks via Lyapunov-Based Neural Networks","target":"https://pmc.ncbi.nlm.nih.gov/articles/PMC12197249/","line":890},{"title":"Learning Neural Network Safe Tracking Controllers from Backward Reachable Sets","target":"https://arxiv.org/html/2511.21953","line":891},{"title":"Certified Neural Network Control Architectures","target":"https://www.mdpi.com/2227-7390/13/10/1677","line":892},{"title":"Robust Deep Reinforcement Learning Through Adversarial Attacks and Training: A Survey","target":"https://ar5iv.labs.arxiv.org/html/2403.00420v1","line":893},{"title":"Data-driven Replay Attack Detection for Unknown CPS","target":"https://www.sciencedirect.com/science/article/abs/pii/S0020025524004754","line":894},{"title":"Machine Learning-Based Detection of Cyberattacks in ACC Systems","target":"https://www.nature.com/articles/s41598-025-20096-5","line":895},{"title":"Security Control of CPS under Cyber Attacks: A Survey","target":"https://pmc.ncbi.nlm.nih.gov/articles/PMC11207848/","line":896},{"title":"Reinforcement Learning Solution for CPS Security Against Replay Attacks","target":"https://dl.acm.org/doi/abs/10.1109/TIFS.2023.3268532","line":897},{"title":"NNV: The Neural Network Verification Tool","target":"https://github.com/verivital/nnv","line":898},{"title":"Injection Attacks Toolbox in MATLAB/Simulink","target":"https://ieeexplore.ieee.org/document/8972171/","line":899},{"title":"Detecting Stealthy Cyberattacks on ACC Vehicles","target":"https://arxiv.org/html/2310.17091","line":900},{"title":"Resilient Interval Observer-Based Control for Cooperative ACC under FDI Attack","target":"https://arxiv.org/html/2601.12625","line":901},{"title":"AI-Based IDS for In-Vehicle Networks: A Survey","target":"https://dl.acm.org/doi/10.1145/3570954","line":902},{"title":"Development of Injection Attacks Toolbox","target":"https://www.researchgate.net/publication/338948921","line":903},{"title":"IBM Adversarial Robustness Toolbox (ART)","target":"https://adversarial-robustness-toolbox.readthedocs.io/","line":907},{"title":"Foolbox: Adversarial Examples Toolbox","target":"https://github.com/bethgelab/foolbox","line":908},{"title":"CleverHans: Adversarial Example Library","target":"https://github.com/cleverhans-lab/cleverhans","line":909},{"title":"Python Control Systems Library - Stochastic Systems","target":"https://python-control.readthedocs.io/en/latest/stochastic.html","line":910},{"title":"Python Control - Discrete Nonlinear Simulation","target":"https://python-control.readthedocs.io/en/0.10.2/examples/simulating_discrete_nonlinear.html","line":911},{"title":"MATLAB idinput Function","target":"https://www.mathworks.com/help/ident/ref/idinput.html","line":912},{"title":"MATLAB PRBS Input Signals","target":"https://www.mathworks.com/help/slcontrol/ug/prbs-input-signals.html","line":913},{"title":"MATLAB Generate Adversarial Examples","target":"https://www.mathworks.com/help/deeplearning/ug/generate-adversarial-examples.html","line":914},{"title":"MATLAB Train Robust Network","target":"https://www.mathworks.com/help/deeplearning/ug/train-network-robust-to-adversarial-examples.html","line":915},{"title":"MATLAB verifyNetworkRobustness","target":"https://www.mathworks.com/help/deeplearning/ref/verifynetworkrobustness.html","line":916},{"title":"MATLAB Detect and Mitigate Attacks in Platooning","target":"https://www.mathworks.com/help/control/ug/detect-and-mitigate-attacks-in-vehicle-platooning.html","line":917},{"title":"MATLAB Sensor Spoofing Video","target":"https://www.mathworks.com/videos/sensor-spoofing-attacks-consequences-and-countermeasures-1550744665433.html","line":918},{"title":"RobustBench: Adversarial Robustness Benchmark","target":"https://robustbench.github.io/","line":919},{"title":"alpha-beta-CROWN Neural Network Verifier","target":"https://github.com/Verified-Intelligence/alpha-beta-CROWN","line":920},{"title":"Gymnasium Classic Control Environments","target":"https://gymnasium.farama.org/environments/classic_control/","line":921},{"title":"TensorFlow FGSM Tutorial","target":"https://www.tensorflow.org/tutorials/generative/adversarial_fgsm","line":922},{"title":"PyTorch FGSM Tutorial","target":"https://docs.pytorch.org/tutorials/beginner/fgsm_tutorial.html","line":923},{"title":"MIT Underactuated Robotics - Stochastic Systems","target":"https://underactuated.mit.edu/stochastic.html","line":924},{"title":"ONNX Runtime","target":"https://onnxruntime.ai/","line":925},{"title":"ICS Injection Attack Toolbox","target":"https://github.com/sasankapotluri/ICS-Injection_Attack_Toolbox","line":926},{"title":"Adversarial ML Tutorial","target":"https://adversarial-ml-tutorial.org/","line":930},{"title":"MathWorks Adjust Disturbance and Noise Models","target":"https://www.mathworks.com/help/mpc/ug/adjusting-disturbance-and-noise-models.html","line":931},{"title":"Engineering LibreTexts - Noise Modeling","target":"https://eng.libretexts.org/Bookshelves/Industrial_and_Systems_Engineering/Chemical_Process_Dynamics_and_Controls_\\(Woolf\\","line":932},{"title":"ScienceDirect - Process Noise Overview","target":"https://www.sciencedirect.com/topics/engineering/process-noise","line":933}],"metadata":{"tags":[],"parent":"","collections":[],"This report provides a comprehensive survey of noise models, adversarial attack techniques, simulation frameworks, benchmark problems, and recent research (2023--2026) relevant to defending neural network-based tracking controllers against adversarial attacks. The research covers discrete-time affine-in-the-inputs systems of the form $x(k+1) = f(x(k)) + g(x(k))u(k)$, where neural network controllers compute optimal control inputs and adversarial attacks target sensor measurements, actuator signals, or the neural network itself. Key findings include":"(1) a well-established taxonomy of noise and attack models ranging from Gaussian white noise to sophisticated false data injection and replay attacks; (2) mature simulation toolkits in MATLAB (Robust Control Toolbox, Deep Learning Toolbox, NNV) and Python (ART, Foolbox, python-control); (3) emerging research at the intersection of reinforcement learning, adversarial training, and control-theoretic stability guarantees; and (4) practical IDS/ACC benchmarks directly relevant to this project's analogy framework.","$version":0,"$libraryID":1,"$itemKey":"3ULDQWPF"},"task_lines":[],"tasks":{},"codeblock_ranges":[[27,33],[37,45],[59,66],[84,90],[100,109],[137,148],[152,161],[165,171],[183,193],[197,204],[228,236],[240,245],[255,258],[278,285],[303,311],[387,391],[413,420],[435,451],[461,467],[490,507],[518,534],[553,564],[574,591]],"last_embed":{"hash":"1vrt5e0","at":1771129934274}},"smart_blocks:Resources/adversarial-attacks-tracking-control-nn-2026-02-14.md##3. Simulation Frameworks and Tools": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07567582,-0.04813676,-0.00564801,-0.00004275,-0.00501482,0.0007942,0.0068333,-0.00372533,-0.00360969,0.00415052,0.04426548,-0.04190663,0.05191851,0.05300667,0.03069508,0.0119719,-0.02773399,0.04258643,0.02797156,0.0136261,0.05471412,-0.02253639,0.04975475,-0.02990766,0.02686715,0.01225275,0.02116422,0.00075712,-0.06132568,-0.26961517,0.02155795,-0.03095585,0.02151291,-0.00801831,-0.0441514,-0.03452805,-0.06500062,0.0204733,-0.05997181,0.02173062,0.03940652,0.05370332,0.00555024,-0.05501018,0.01643035,-0.09246639,-0.01571198,-0.04534449,-0.08284661,-0.03697745,-0.04357422,-0